---
const experiences = [
  {
    role: 'Machine Operator & Team Lead',
    date: '2022 – Present',
    description: [
      'Led second-shift operations, supervising a crew of 3+ and delegating tasks to sustain 100% productivity targets.',
      'Operated complex cardboard manufacturing machinery, performing routine quality control checks and resolving mechanical issues proactively.',
      'Maintained clear, real-time communication between supervisors and helpers to ensure seamless shift handoffs.',
      'Enforced strict workplace safety protocols, maintaining a fully compliant production floor.',
    ],
  },
];
---

<div class="space-y-10">
  {
    experiences.map((exp) => (
      <div class="relative pl-8 group">
        <!-- Timeline line -->
        <div class="absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-sky-500/60 via-sky-500/20 to-transparent" />
        <!-- Timeline dot -->
        <div class="absolute left-0 top-1 w-2 h-2 -translate-x-[3px] rounded-full bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.8)] group-hover:scale-125 transition-transform" />

        <div class="space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <h3 class="text-base font-semibold text-white">{exp.role}</h3>
            <span class="text-xs font-mono text-sky-400/80 border border-sky-400/20 rounded-full px-2.5 py-0.5 bg-sky-400/5 w-fit">
              {exp.date}
            </span>
          </div>
          <ul class="space-y-2">
            {exp.description.map((point) => (
              <li class="flex gap-2 text-sm text-slate-400 leading-relaxed">
                <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sky-500/60" />
                {point}
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))
  }
</div>

---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300 transition-all duration-200 hover:border-sky-400/40 hover:bg-sky-400/10 hover:text-sky-300 hover:scale-105"
>
  <slot />
  {label}
</a>

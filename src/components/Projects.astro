---
import ProjectModal from './ProjectModal.astro';

const tagColors: Record<string, string> = {
  Python: 'bg-yellow-400/10 text-yellow-300 border-yellow-400/20',
  Pandas: 'bg-blue-400/10 text-blue-300 border-blue-400/20',
  Matplotlib: 'bg-purple-400/10 text-purple-300 border-purple-400/20',
  Statistics: 'bg-green-400/10 text-green-300 border-green-400/20',
  'Data Analysis': 'bg-emerald-400/10 text-emerald-300 border-emerald-400/20',
  BeautifulSoup: 'bg-orange-400/10 text-orange-300 border-orange-400/20',
};

const projects = [
  {
    id: 'citi-bike',
    title: 'NYC Citi Bike Data Analysis',
    tags: ['Python', 'Pandas', 'Matplotlib'],
    description:
      'Ingested and cleaned a record Citi Bike dataset using Pandas, resolving missing values and standardizing schema. Performed EDA to uncover ridership trends, peak usage windows, and station-level demand patterns. Produced charts delivering actionable recommendations for bike redistribution.',
    github: 'https://github.com/Alexib173',
    charts: [
      { title: 'Peak Usage Hours', image: '/citi-bike-charts/peak-usage-hours.png' },
      { title: 'Average Trip Duration', image: '/citi-bike-charts/avg-duration.png' },
      { title: 'Station Imbalance Analysis', image: '/citi-bike-charts/station-imbalance.png' },
      { title: 'Top Routes', image: '/citi-bike-charts/top-routes.png' },
    ],
    qa: [
      { q: 'What was the dataset size?', a: 'The dataset contained over 25 million Citi Bike trips spanning multiple years.' },
      { q: 'What were the key insights?', a: 'Analysis revealed that casual users had higher average trip duration, peak usage occurred during morning and evening commute hours, and certain stations consistently experienced imbalance issues.' },
      { q: 'How was the data cleaned?', a: 'Missing values were handled using statistical imputation, outliers were identified and contextualized, and timestamp formatting was standardized across the entire dataset.' },
    ],
  },
  {
    id: 'sixth-man',
    title: 'The Sixth Man System',
    tags: ['Python', 'Statistics', 'Data Analysis'],
    description:
      'Designed a multi-dimensional statistical matching algorithm to identify ideal basketball recruits from large player datasets. Built a scoring engine ranking candidates on shooting efficiency, defensive rating, and positional versatility.',
    github: 'https://github.com/Alexib173',
    charts: [],
    qa: [
      { q: 'How does the matching algorithm work?', a: 'The system uses weighted multi-factor analysis, comparing prospect metrics against position-specific benchmarks and team composition needs.' },
      { q: 'What metrics are evaluated?', a: 'Shooting efficiency (2P%, 3P%, FT%), defensive rating, positional versatility, and consistency metrics across different game situations.' },
    ],
  },
  {
    id: 'web-scraper',
    title: 'Web Scraped Data Pipeline',
    tags: ['Python', 'BeautifulSoup', 'Pandas'],
    description:
      'Built a comprehensive MLB data pipeline scraping baseball statistics from Baseball Reference across 5 years (2020-2024). Engineered four specialized scrapers for team batting, standings, and player pitching/batting data. Cleaned and normalized raw data, reducing inconsistencies by over 90%. Created data visualizations answering key questions about player performance and team success.',
    github: 'https://github.com/Alexib173',
    charts: [
      { title: 'Top 5 Home Run Hitters by Season', image: '/Data-Pipeline-charts/Top 5 homeruns.png' },
      { title: 'Team OPS Leaders by Season', image: '/Data-Pipeline-charts/Ops-leaders.png' },
      { title: 'Consecutive 100+ Win Seasons', image: '/Data-Pipeline-charts/consecutives-wins.png' },
      { title: 'Top 5 Strikeout Leaders by Season', image: '/Data-Pipeline-charts/strikeout-leaderst.png' },
    ],
    qa: [
      { q: 'What data sources were used?', a: 'Scraped data from Baseball Reference (baseball-reference.com) using four specialized functions targeting team batting stats, standings, and player pitching/batting leaders.' },
      { q: 'How were requests handled safely?', a: 'Implemented User-Agent headers to mimic human browsers, added timeouts to prevent hangs, included 1-second delays between requests to respect server resources, and handled errors gracefully.' },
      { q: 'What insights did the analysis reveal?', a: 'Identified top home run hitters each year, tracked which teams had the highest OPS performance, found teams achieving 100+ consecutive win seasons, and analyzed strikeout leader trends across 5 years.' },
      { q: 'How was the data cleaned?', a: 'Removed header rows from multi-index tables, converted numeric columns with error handling, filtered invalid records, dropped players below minimum at-bats threshold, and standardized team name formats.' },
    ],
  },
];
---

<style>
  .project-card {
    cursor: pointer;
  }

  .project-card:hover h3 {
    color: rgb(56, 189, 248);
  }
</style>

<div class="grid gap-5">
  {
    projects.map((project, i) => (
      <div
        class="project-card group relative rounded-2xl border border-white/8 bg-white/[0.03] p-6 transition-all duration-300 hover:border-sky-400/30 hover:bg-sky-400/[0.04] hover:-translate-y-0.5"
        style={`animation-delay: ${i * 100}ms`}
        data-project-id={project.id}
        data-project-title={project.title}
        data-project-description={project.description}
        data-project-github={project.github}
        data-project-tags={JSON.stringify(project.tags)}
        data-project-charts={JSON.stringify(project.charts)}
        data-project-qa={JSON.stringify(project.qa)}
      >
        <!-- Subtle glow on hover -->
        <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(56,189,248,0.06),transparent)]" />

        <div class="relative space-y-4">
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-base font-semibold text-white leading-snug cursor-pointer hover:text-sky-400 transition-colors">
              {project.title}
            </h3>
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-shrink-0 rounded-full p-1.5 text-slate-500 transition hover:text-sky-400"
              aria-label="View on GitHub"
              onclick="event.stopPropagation()"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                <path d="M9 18c-4.51 2-5-2-7-2"/>
              </svg>
            </a>
          </div>

          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span
                class={`text-xs px-2.5 py-0.5 rounded-full border font-mono ${tagColors[tag] || 'bg-white/5 text-slate-400 border-white/10'}`}
              >
                {tag}
              </span>
            ))}
          </div>

          <p class="text-sm text-slate-400 leading-relaxed">{project.description}</p>
        </div>
      </div>
    ))
  }
</div>

<!-- Project Modals -->
{projects.map((project) => <ProjectModal projectId={project.id} />)}

<script is:inline>
  document.querySelectorAll('.project-card').forEach((card) => {
    card.addEventListener('click', function() {
      const cardElement = this;
      const projectId = cardElement.dataset.projectId;
      const projectTitle = cardElement.dataset.projectTitle;
      const projectDescription = cardElement.dataset.projectDescription;
      const projectGithub = cardElement.dataset.projectGithub;
      const projectTags = JSON.parse(cardElement.dataset.projectTags || '[]');
      const projectCharts = JSON.parse(cardElement.dataset.projectCharts || '[]');
      const projectQa = JSON.parse(cardElement.dataset.projectQa || '[]');

      // Set modal title and description
      const modal = document.getElementById(`modal-${projectId}`);
      const titleEl = document.getElementById(`modal-title-${projectId}`);
      const descEl = document.getElementById(`modal-description-${projectId}`);
      const githubEl = document.getElementById(`modal-github-${projectId}`);

      if (titleEl) titleEl.textContent = projectTitle || '';
      if (descEl) descEl.textContent = projectDescription || '';
      if (githubEl && githubEl.tagName === 'A') {
        githubEl.setAttribute('href', projectGithub || '');
      }

      // Set tags
      const tagsContainer = document.getElementById(`modal-tags-${projectId}`);
      if (tagsContainer) {
        tagsContainer.innerHTML = projectTags
          .map((tag) => `<span class="text-xs px-2.5 py-0.5 rounded-full border font-mono bg-white/5 text-slate-400 border-white/10">${tag}</span>`)
          .join('');
      }

      // Set charts
      const chartsContainer = document.getElementById(`modal-charts-${projectId}`);
      if (chartsContainer && projectCharts.length > 0) {
        chartsContainer.innerHTML = `
          <div>
            <h3 class="text-sm font-semibold text-sky-400 uppercase tracking-wide mb-4">Visualizations</h3>
            <div class="space-y-4">
              ${projectCharts.map((chart) => `
                <div class="rounded-lg bg-white/5 p-3 border border-white/10">
                  <p class="text-xs text-slate-400 mb-3">${chart.title}</p>
                  <img src="${chart.image}" alt="${chart.title}" class="rounded-md w-full bg-white/80 p-3" />
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }

      // Set Q&A
      const qaContainer = document.getElementById(`modal-qa-${projectId}`);
      if (qaContainer && projectQa.length > 0) {
        qaContainer.innerHTML = `
          <div>
            <h3 class="text-sm font-semibold text-sky-400 uppercase tracking-wide mb-3">Questions & Answers</h3>
            <div class="space-y-3">
              ${projectQa.map((item) => `
                <div class="rounded-lg bg-white/5 p-3 border border-white/10">
                  <p class="text-sm font-medium text-white mb-1">${item.q}</p>
                  <p class="text-xs text-slate-400">${item.a}</p>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }

      // Show modal
      if (modal) {
        modal.classList.remove('hidden');
      }
    });
  });
</script>

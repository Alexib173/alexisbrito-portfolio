---
interface Props {
  projectId: string;
}
---

<div id={`modal-${Astro.props.projectId}`} class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm" onclick="event.target === this && this.classList.add('hidden')">
  <div class="bg-[#0a0f1a]/95 border border-white/10 rounded-2xl max-w-6xl w-full max-h-[90vh] overflow-y-auto shadow-2xl" onclick="event.stopPropagation()">
    <!-- Close button -->
    <div class="sticky top-0 z-10 flex justify-between items-center p-6 border-b border-white/10 bg-[#0a0f1a]">
      <h2 id={`modal-title-${Astro.props.projectId}`} class="text-2xl font-bold text-white"></h2>
      <button
        onclick={`document.getElementById('modal-${Astro.props.projectId}').classList.add('hidden')`}
        class="rounded-full p-2 text-slate-400 hover:text-white hover:bg-white/10 transition"
        aria-label="Close modal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6l-12 12M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Content -->
    <div class="p-6 space-y-6">
      <!-- Description -->
      <div>
        <h3 class="text-sm font-semibold text-sky-400 uppercase tracking-wide mb-2">About</h3>
        <p id={`modal-description-${Astro.props.projectId}`} class="text-slate-300 text-sm leading-relaxed"></p>
      </div>

      <!-- Tags -->
      <div>
        <h3 class="text-sm font-semibold text-sky-400 uppercase tracking-wide mb-3">Technologies</h3>
        <div id={`modal-tags-${Astro.props.projectId}`} class="flex flex-wrap gap-2"></div>
      </div>

      <!-- Charts/Images -->
      <div id={`modal-charts-${Astro.props.projectId}`} class="space-y-4"></div>

      <!-- Q&A Section -->
      <div id={`modal-qa-${Astro.props.projectId}`} class="space-y-4"></div>

      <!-- GitHub Link -->
      <div class="pt-4 border-t border-white/10">
        <a
          id={`modal-github-${Astro.props.projectId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sky-400 hover:text-sky-300 transition font-medium"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          View on GitHub
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  #modal {
    animation: fadeIn 0.3s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
